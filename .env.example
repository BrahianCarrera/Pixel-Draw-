# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (Prisma Accelerate)
# DATABASE_URL = Prisma Accelerate connection URL (used for runtime queries via PrismaClient)
DATABASE_URL="prisma://accelerate.prisma-data.net/?api_key=YOUR_ACCELERATE_API_KEY"
# DIRECT_URL = Direct Supabase connection string (used for prisma migrate)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.xxxx.supabase.co:5432/postgres"

# CORS Configuration
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# JWT Authentication
JWT_SECRET="super-secret-jwt-key-pixeldraw-change-in-prod"
JWT_EXPIRES_IN="7d"
